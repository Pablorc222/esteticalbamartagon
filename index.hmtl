<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Estética Alba Martagón</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;700&family=Barlow:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{--bg:#fbf3ef;--panel:#ffffff;--gold:#c9806f;--cta:#b8486b;
 --txt:#3b2a2a;--mute:#7d6a66;--line:#ecd9d1;
 --head:'Oswald',Impact,sans-serif;--body:'Barlow',system-ui,sans-serif}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:var(--body);background:var(--bg);color:var(--txt);line-height:1.6;-webkit-font-smoothing:antialiased}
a{color:inherit;text-decoration:none}
:focus-visible{outline:3px solid var(--gold);outline-offset:3px}
.wrap{max-width:1100px;margin:0 auto;padding:0 24px}
h1,h2,h3{font-family:var(--head);text-transform:uppercase;letter-spacing:.02em;line-height:1.1}
.btn{display:inline-block;font-family:var(--head);text-transform:uppercase;letter-spacing:.08em;font-size:.9rem;padding:14px 30px;background:var(--gold);color:#fff;font-weight:500;border:0;cursor:pointer;transition:transform .2s,background .2s}
.btn:hover{transform:translateY(-2px);background:#b56b5a}
.btn.red{background:var(--cta);color:#fff}.btn.red:hover{background:#983a58}
.btn.sm{padding:9px 18px;font-size:.78rem}
.top{background:var(--gold);color:#fff;font-size:.82rem;padding:6px 0}
.top .wrap{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap}
nav.bar{position:sticky;top:0;z-index:20;background:rgba(251,243,239,.9);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
nav.bar .wrap{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;height:70px;gap:20px}
nav.bar .l,nav.bar .r{display:flex;gap:26px;font-family:var(--head);text-transform:uppercase;font-size:.85rem;letter-spacing:.08em}
nav.bar .r{justify-content:flex-end;align-items:center}
nav.bar a:hover{color:var(--gold)}
.logo{font-family:var(--head);font-size:1.3rem;letter-spacing:.18em;color:var(--gold);text-align:center}
.hero{position:relative;min-height:88vh;display:grid;place-items:center;text-align:center;overflow:hidden;isolation:isolate}
.hero .bg{position:absolute;inset:-5%;z-index:-2;background:var(--hero,radial-gradient(circle at 30% 30%,#f3c9c0,#fbf3ef 75%)) center/cover;animation:zoom 22s ease-in-out infinite alternate}
.hero::after{content:"";position:absolute;inset:0;z-index:-1;background:linear-gradient(180deg,rgba(251,243,239,.35),rgba(251,243,239,.85))}
@keyframes zoom{to{transform:scale(1.12)}}
.hero h1{font-size:clamp(2.6rem,7vw,5.2rem);max-width:16ch;margin:0 auto 14px}
.hero p{color:#6b5652;max-width:52ch;margin:0 auto 30px;font-size:1.1rem}
section{padding:96px 0}
.sec-t{text-align:center;margin-bottom:46px}
.sec-t span{font-family:var(--head);color:var(--gold);letter-spacing:.25em;font-size:.82rem;text-transform:uppercase}
.sec-t h2{font-size:clamp(1.9rem,4vw,2.8rem);margin-top:6px}
.about .wrap{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center}
.about h2{font-size:clamp(1.9rem,4vw,2.8rem);margin:6px 0 16px}
.about p{color:var(--mute);margin-bottom:12px}
.ph{background:linear-gradient(150deg,#f6dcd3,#efc9bf);display:grid;place-items:center;color:#a98378;font-size:.85rem;text-align:center;padding:16px;background-size:cover;background-position:center}
.about .ph{aspect-ratio:4/5;border:1px solid var(--line)}
.stats{background:linear-gradient(90deg,#c9806f,#dc9a8a,#c9806f);color:#fff;padding:44px 0}
.stats .wrap{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;text-align:center}
.stats b{display:block;font-family:var(--head);font-size:clamp(2rem,5vw,3rem);line-height:1}
.stats span{font-family:var(--head);text-transform:uppercase;letter-spacing:.1em;font-size:.78rem}
.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
.card{background:var(--panel);border:1px solid var(--line);transition:transform .3s,border-color .3s}
.card:hover{transform:translateY(-6px);border-color:var(--gold)}
.card .ph{aspect-ratio:4/3}
.card .t{padding:22px}
.card h3{font-size:1.2rem;color:var(--gold);margin-bottom:8px}
.card p{color:var(--mute);font-size:.95rem;margin-bottom:16px}
.cta{background:linear-gradient(120deg,#d98aa0,#e9b8a6);text-align:center;padding:84px 0}
.cta h2{color:#fff;font-size:clamp(1.8rem,4vw,2.6rem);margin-bottom:10px}
.cta p{color:#fff;margin-bottom:26px}
.contact .wrap{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center}
.contact h2{font-size:clamp(1.9rem,4vw,2.8rem);margin-bottom:14px}
.contact address{font-style:normal;color:var(--mute);margin-bottom:22px;font-size:1.1rem}
.map{display:flex;flex-direction:column;justify-content:flex-end;aspect-ratio:4/3;padding:26px;border:1px solid var(--line);background:repeating-linear-gradient(45deg,#f6e6df 0 16px,#fbf3ef 16px 32px)}
.map b{font-family:var(--head);color:var(--gold);text-transform:uppercase;letter-spacing:.1em}
footer{border-top:1px solid var(--line);color:#9a8680;font-size:.85rem;padding:26px 0}
footer .wrap{display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px}
.wa{position:fixed;right:18px;bottom:18px;z-index:30;width:58px;height:58px;border-radius:50%;background:#1fa855;display:grid;place-items:center;box-shadow:0 6px 20px rgba(0,0,0,.25);transition:transform .2s}.wa:hover{transform:scale(1.08)}
.rv{opacity:0;transform:translateY(28px);transition:opacity .8s,transform .8s}
.rv.in{opacity:1;transform:none}
@media (max-width:820px){
 nav.bar .wrap{grid-template-columns:1fr auto}nav.bar .l{display:none}nav.bar .r a:not(.btn){display:none}
 .about .wrap,.contact .wrap{grid-template-columns:1fr}
 .stats .wrap{grid-template-columns:1fr 1fr}.grid3{grid-template-columns:1fr}
 section{padding:68px 0}.top .wrap{justify-content:center}
}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}.rv{opacity:1;transform:none}}
</style>
</head>
<body>
<script>
var CFG={
 name:"Estética Alba Martagón", logo:"ALBA MARTAGÓN",
 wa:"34684373028", phone:"684 37 30 28",
 book:"https://widget.treatwell.es/establecimiento/studio-54-2/",
 ig:"https://www.instagram.com/nails.martagon/",
 address:"Calle Alonso Barba, 46 (local) · Lepe", maps:"Calle+Alonso+Barba+46+Lepe",
 heroImg:"", aboutImg:"",
 title:"Uñas que se notan", sub:"Especialista en manicura, pedicura y diseño de cejas. Diseños únicos, detalle y acabado impecable en Lepe.",
 btn:"Reservar cita",
 about:["En Estética Alba Martagón cuidamos cada detalle: manicura semipermanente, acrílicas, pedicura y diseño de cejas, con un acabado que se nota.","Tú eliges el diseño y nosotras lo hacemos realidad. Reserva online en un minuto."],
 stats:[[361,"Trabajos publicados","+"],[596,"Seguidoras",""],[6,"Servicios",""],[1,"Local en Lepe",""]],
 services:[["Manicura semipermanente","Color duradero, brillo y diseños a tu medida.",""],["Uñas acrílicas","Largo, forma y diseño personalizados.",""],["Pedicura","Cuidado completo para unos pies perfectos.",""],["Diseño de cejas","Cejas armoniosas que enmarcan tu mirada.",""],["Microblading","Cejas definidas con aspecto natural.",""],["Gemas dentales","Un toque de brillo en tu sonrisa.",""]]
};
</script>
<div class="top"><div class="wrap"><span id="tAddr"></span><span id="tPhone"></span></div></div>
<nav class="bar"><div class="wrap">
  <div class="l"><a href="#inicio">Inicio</a><a href="#estudio">Nosotras</a><a href="#servicios">Servicios</a></div>
  <a class="logo" href="#" id="logo"></a>
  <div class="r"><a href="#contacto">Contacto</a><a class="btn red sm" id="navBtn" target="_blank" rel="noopener"></a></div>
</div></nav>
<header class="hero" id="inicio"><div class="bg"></div>
  <div class="wrap"><h1 id="hTitle"></h1><p id="hSub"></p><a class="btn" id="hBtn" target="_blank" rel="noopener"></a></div>
</header>
<section class="about" id="estudio"><div class="wrap">
  <div class="rv"><div class="sec-t" style="text-align:left"><span>Sobre nosotras</span></div><h2 id="aTitle"></h2><div id="aText"></div><a class="btn" href="#servicios" style="margin-top:10px">Nuestros servicios</a></div>
  <div class="ph rv" id="aImg">Foto del local</div>
</div></section>
<div class="stats"><div class="wrap" id="stats"></div></div>
<section id="servicios"><div class="wrap">
  <div class="sec-t rv"><span>Qué hacemos</span><h2>Nuestros servicios</h2></div>
  <div class="grid3" id="svc"></div>
</div></section>
<div class="cta"><div class="wrap rv"><h2>¿Te hacemos las uñas?</h2><p>Elige servicio y hora en tu calendario online.</p><a class="btn red" id="ctaBtn" target="_blank" rel="noopener">Reservar ahora</a></div></div>
<section class="contact" id="contacto"><div class="wrap">
  <div class="rv"><h2>Ven a vernos</h2><address id="addr"></address><a class="btn" id="cBtn" target="_blank" rel="noopener">Escribir por WhatsApp</a></div>
  <a class="map rv" id="map" target="_blank" rel="noopener"><b>Cómo llegar</b></a>
</div></section>
<a class="wa" id="wa" target="_blank" rel="noopener" aria-label="WhatsApp"><svg viewBox="0 0 32 32" aria-hidden="true" style="width:30px;height:30px;fill:#fff"><path d="M16 3C8.8 3 3 8.8 3 16c0 2.3.6 4.5 1.7 6.4L3 29l6.8-1.8A13 13 0 0 0 16 29c7.2 0 13-5.8 13-13S23.2 3 16 3zm0 23.700c-2 0-3.900-.6-5.500-1.600l-.4-.2-4 1 1.100-3.900-.3-.4A10.700 10.700 0 1 1 16 26.700zm5.900-8c-.3-.2-1.900-.9-2.200-1-.3-.1-.5-.2-.7.200-.2.300-.8 1-1 1.200-.2.200-.4.200-.7.100-.3-.2-1.400-.5-2.600-1.600-1-.9-1.600-1.900-1.800-2.200-.2-.3 0-.5.100-.7l.5-.6c.2-.2.200-.3.300-.6.100-.2.100-.4 0-.6l-1-2.300c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.100-.9.400-.3.300-1.200 1.200-1.200 2.900s1.200 3.300 1.400 3.500c.2.200 2.400 3.700 5.900 5.100 3.500 1.400 3.500.9 4.100.9.600-.1 1.900-.8 2.200-1.500.3-.8.300-1.400.2-1.500-.1-.1-.3-.2-.6-.4z"/></svg></a>
<footer><div class="wrap"><span id="foot"></span><a id="fIg" target="_blank" rel="noopener">Instagram @nails.martagon</a></div></footer>
<script>
(function(){
 var $=function(i){return document.getElementById(i)},W=CFG.book;
 document.title=CFG.name;
 $("tAddr").textContent="📍 "+CFG.address;
 $("logo").textContent=CFG.logo;$("foot").textContent="© "+CFG.name;$("fIg").href=CFG.ig;
 ["navBtn","hBtn","ctaBtn"].forEach(function(i){$(i).href=W});
 var WA="https://wa.me/"+CFG.wa+"?text="+encodeURIComponent("Hola, quiero pedir una cita");$("cBtn").href=WA;$("wa").href=WA;$("tPhone").textContent="☎ "+CFG.phone;
 $("navBtn").textContent=CFG.btn;$("hBtn").textContent=CFG.btn;
 $("hTitle").textContent=CFG.title;$("hSub").textContent=CFG.sub;
 if(CFG.heroImg)document.documentElement.style.setProperty("--hero","url('"+CFG.heroImg+"')");
 if(CFG.aboutImg){$("aImg").style.backgroundImage="url('"+CFG.aboutImg+"')";$("aImg").textContent=""}
 $("aTitle").textContent=CFG.name;
 $("aText").innerHTML=CFG.about.map(function(t){return"<p>"+t+"</p>"}).join("");
 $("stats").innerHTML=CFG.stats.map(function(s){return'<div><b data-n="'+s[0]+'" data-s="'+s[2]+'">0</b><span>'+s[1]+"</span></div>"}).join("");
 $("svc").innerHTML=CFG.services.map(function(s){return'<div class="card rv"><div class="ph"'+(s[2]?' style="background-image:url(\''+s[2]+'\')"':"")+">"+(s[2]?"":"Foto")+'</div><div class="t"><h3>'+s[0]+"</h3><p>"+s[1]+'</p><a class="btn sm" href="'+W+'" target="_blank" rel="noopener">Reservar</a></div></div>'}).join("");
 $("addr").textContent=CFG.address;
 $("map").href="https://www.google.com/maps/search/?api=1&query="+CFG.maps;
 var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add("in");io.unobserve(e.target)}})},{threshold:.15});
 document.querySelectorAll(".rv").forEach(function(e){io.observe(e)});
 var co=new IntersectionObserver(function(es){es.forEach(function(e){if(!e.isIntersecting)return;var el=e.target,n=+el.dataset.n,t=0;co.unobserve(el);
  var iv=setInterval(function(){t+=1/45;if(t>=1){t=1;clearInterval(iv)}el.textContent=Math.round(n*t).toLocaleString("es-ES")+el.dataset.s},25)})},{threshold:.6});
 document.querySelectorAll("[data-n]").forEach(function(e){co.observe(e)});
})();
</script>
</body>
</html>
